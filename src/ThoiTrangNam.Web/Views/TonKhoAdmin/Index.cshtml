@model StockAlertViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Cảnh báo tồn kho";
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">Cảnh báo tồn kho</h1>
    <form method="get" asp-controller="TonKhoAdmin" asp-action="Index" class="d-flex align-items-center gap-2">
        <label for="nguong" class="small mb-0">Sắp hết khi tồn kho ≤</label>
        <input id="nguong" name="nguong" type="number" min="1" max="1000" value="@Model.NguongSapHet" class="form-control form-control-sm" style="width:90px" />
        <button type="submit" class="btn btn-sm btn-primary">Áp dụng</button>
    </form>
</div>

<h2 class="h5 text-danger"><i class="bi bi-x-octagon"></i> Hết hàng (@Model.HetHang.Count)</h2>
@if (Model.HetHang.Count == 0)
{
    <p class="text-muted">Không có biến thể nào hết hàng.</p>
}
else
{
    @await Html.PartialAsync("_StockTable", Model.HetHang)
}

<h2 class="h5 text-warning-emphasis mt-4"><i class="bi bi-exclamation-triangle"></i> Sắp hết hàng (@Model.SapHet.Count)</h2>
@if (Model.SapHet.Count == 0)
{
    <p class="text-muted">Không có biến thể nào sắp hết hàng.</p>
}
else
{
    @await Html.PartialAsync("_StockTable", Model.SapHet)
}
