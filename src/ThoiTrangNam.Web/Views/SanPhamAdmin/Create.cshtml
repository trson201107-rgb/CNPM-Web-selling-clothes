@model SanPhamFormViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Thêm sản phẩm";
}
<h1 class="h3 mb-3">Thêm sản phẩm</h1>
<form method="post" asp-controller="SanPhamAdmin" asp-action="Create" id="productForm">
    <partial name="_Form" model="Model" />
    <div class="mt-4 d-flex gap-2">
        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Lưu sản phẩm</button>
        <a class="btn btn-outline-secondary" asp-controller="SanPhamAdmin" asp-action="Index">Hủy</a>
    </div>
</form>
