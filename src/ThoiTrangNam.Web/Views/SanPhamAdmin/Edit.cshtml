@model SanPhamFormViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Sửa sản phẩm";
}
<h1 class="h3 mb-3">Sửa sản phẩm <span class="text-muted fs-6">(mã @Model.MaSP)</span></h1>
<form method="post" asp-controller="SanPhamAdmin" asp-action="Edit" asp-route-id="@Model.MaSP" id="productForm">
    <partial name="_Form" model="Model" />
    <div class="mt-4 d-flex gap-2">
        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Lưu thay đổi</button>
        <a class="btn btn-outline-secondary" asp-controller="SanPhamAdmin" asp-action="Index">Hủy</a>
    </div>
</form>
