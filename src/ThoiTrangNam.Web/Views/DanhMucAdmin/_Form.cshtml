@model DanhMuc
<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
<div class="mb-3">
    <label asp-for="TenDM" class="form-label">Tên danh mục</label>
    <input asp-for="TenDM" class="form-control" maxlength="50" />
    <span asp-validation-for="TenDM" class="text-danger small"></span>
</div>
<div class="mb-3">
    <label asp-for="MoTa" class="form-label">Mô tả</label>
    <textarea asp-for="MoTa" class="form-control" rows="3" maxlength="255"></textarea>
    <span asp-validation-for="MoTa" class="text-danger small"></span>
</div>
