@model List<DanhMucAdminItem>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý danh mục";
    var laAdmin = User.IsInRole("Admin");
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">Danh mục</h1>
    <a class="btn btn-primary" asp-controller="DanhMucAdmin" asp-action="Create"><i class="bi bi-plus-lg"></i> Thêm danh mục</a>
</div>

@if (Model.Count == 0)
{
    <div class="empty-state">
        <i class="bi bi-tags"></i>
        <h2 class="h5 mt-2">Chưa có danh mục nào</h2>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr><th>Mã</th><th>Tên</th><th>Mô tả</th><th class="text-end">Số sản phẩm</th><th>Trạng thái</th><th>Cập nhật</th><th class="text-end">Thao tác</th></tr>
            </thead>
            <tbody>
                @foreach (var d in Model)
                {
                    <tr class="@(d.TrangThai ? "" : "table-secondary")">
                        <td>@d.MaDM</td>
                        <td class="fw-semibold">@d.TenDM</td>
                        <td class="text-muted small">@d.MoTa</td>
                        <td class="text-end">@d.SoSanPham</td>
                        <td>
                            @if (d.TrangThai) { <span class="badge bg-success">Hiển thị</span> }
                            else { <span class="badge bg-secondary">Đã ẩn</span> }
                        </td>
                        <td class="small text-muted">
                            @if (d.NgayCapNhat.HasValue)
                            {
                                <div>@d.NgayCapNhat.Value.ToString("dd/MM/yyyy HH:mm")</div>
                                <div>@(d.NguoiCapNhatTen ?? "")</div>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-primary" asp-controller="DanhMucAdmin" asp-action="Edit" asp-route-id="@d.MaDM" title="Sửa"><i class="bi bi-pencil"></i></a>
                            @if (d.TrangThai)
                            {
                                <form method="post" asp-controller="DanhMucAdmin" asp-action="Hide" asp-route-id="@d.MaDM" class="d-inline" data-confirm="Ẩn danh mục này? Sản phẩm thuộc danh mục sẽ không còn hiển thị cho khách.">
                                    <button type="submit" class="btn btn-sm btn-outline-warning" title="Ẩn"><i class="bi bi-eye-slash"></i></button>
                                </form>
                            }
                            else
                            {
                                <form method="post" asp-controller="DanhMucAdmin" asp-action="Show" asp-route-id="@d.MaDM" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-success" title="Hiện lại"><i class="bi bi-eye"></i></button>
                                </form>
                            }
                            @if (laAdmin)
                            {
                                <form method="post" asp-controller="DanhMucAdmin" asp-action="Delete" asp-route-id="@d.MaDM" class="d-inline" data-confirm="Xóa danh mục này? Chỉ xóa được khi danh mục không còn sản phẩm.">
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa"><i class="bi bi-trash"></i></button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
