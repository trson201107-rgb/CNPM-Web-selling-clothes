@model RegisterViewModel
@{
    ViewData["Title"] = "Đăng ký";
}
<div class="auth-card">
    <h1 class="h3 mb-3">Đăng ký tài khoản</h1>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <form method="post" asp-controller="Account" asp-action="Register">
        <div class="mb-3">
            <label asp-for="HoTen" class="form-label">Họ tên</label>
            <input asp-for="HoTen" class="form-control" />
            <span asp-validation-for="HoTen" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Email" class="form-label">Email</label>
            <input asp-for="Email" class="form-control" autocomplete="username" />
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="SoDienThoai" class="form-label">Số điện thoại</label>
            <input asp-for="SoDienThoai" class="form-control" />
            <span asp-validation-for="SoDienThoai" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="MatKhau" class="form-label">Mật khẩu</label>
            <input asp-for="MatKhau" type="password" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="MatKhau" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="XacNhanMatKhau" class="form-label">Nhập lại mật khẩu</label>
            <input asp-for="XacNhanMatKhau" type="password" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="XacNhanMatKhau" class="text-danger small"></span>
        </div>
        <button type="submit" class="btn btn-primary w-100">Đăng ký</button>
    </form>
    <p class="mt-3 mb-0 text-center">Đã có tài khoản? <a asp-action="Login">Đăng nhập</a></p>
</div>
