@model LoginViewModel
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@{
    ViewData["Title"] = "Đăng nhập";
}
<div class="auth-card">
    <h1 class="h3 mb-3">Đăng nhập</h1>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <form method="post" asp-controller="Account" asp-action="Login">
        <input type="hidden" asp-for="ReturnUrl" />
        <div class="mb-3">
            <label asp-for="Email" class="form-label">Email</label>
            <input asp-for="Email" class="form-control" autocomplete="username" />
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="MatKhau" class="form-label">Mật khẩu</label>
            <input asp-for="MatKhau" type="password" class="form-control" autocomplete="current-password" />
            <span asp-validation-for="MatKhau" class="text-danger small"></span>
        </div>
        <div class="form-check mb-3">
            <input asp-for="GhiNho" class="form-check-input" />
            <label asp-for="GhiNho" class="form-check-label">Ghi nhớ đăng nhập</label>
        </div>
        <button type="submit" class="btn btn-primary w-100">Đăng nhập</button>
    </form>
    <p class="mt-3 mb-0 text-center">Chưa có tài khoản? <a asp-action="Register">Đăng ký</a></p>

    @if (Env.IsDevelopment())
    {
        <div class="demo-box mt-4">
            <div class="fw-semibold mb-1">Tài khoản mẫu (chỉ hiện khi phát triển)</div>
            <div class="small">Admin: duc.pham@shop.vn</div>
            <div class="small">Staff: cuong.le@shop.vn</div>
            <div class="small">Khách: an.nguyen@gmail.com</div>
            <div class="small">Mật khẩu chung: Demo@123</div>
        </div>
    }
</div>
